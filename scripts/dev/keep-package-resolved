#!/bin/sh
# Runs a command (xcodebuild) and puts Package.resolved back as it was, even when the command fails.
#
# Package.resolved belongs to SwiftPM: it pins what Package.swift needs (swift-protobuf), and `swift test` rewrites it
# to exactly that. Xcode resolves the generated project, which also depends on Sparkle (project.yml), and writes its
# pin into the same file, so every build would leave the checkout dirty (#87). Sparkle is pinned with exactVersion in
# project.yml instead, so dropping Xcode's copy of the pin changes nothing.
set -eu
cd "$(dirname "$0")/../.."
backup=$(mktemp)
cp Package.resolved "$backup"
status=0
"$@" || status=$?
cp "$backup" Package.resolved
rm -f "$backup"
exit "$status"
