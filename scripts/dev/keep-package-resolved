#!/bin/sh
# Runs a command (xcodebuild) and restores Package.resolved afterwards, even when it fails. Xcode adds a Sparkle pin
# to the file that `swift test` would drop again; Sparkle is pinned by exactVersion in project.yml instead (#87).
set -eu
resolved=$(dirname "$0")/../../Package.resolved
backup=$(mktemp)
cp "$resolved" "$backup"
status=0
"$@" || status=$?
cp "$backup" "$resolved"
rm -f "$backup"
exit "$status"
