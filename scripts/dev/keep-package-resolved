#!/bin/sh
# Runs a command (xcodebuild) and restores Package.resolved afterwards, even when it fails or is interrupted. Xcode
# adds a Sparkle pin to the file that `swift test` would drop again; Sparkle is pinned by exactVersion in project.yml
# instead (#87).
set -eu
cd "$(dirname "$0")/../.."
backup=$(mktemp)
cp Package.resolved "$backup"
trap 'cp "$backup" Package.resolved; rm -f "$backup"' EXIT
trap 'exit 130' INT TERM HUP
"$@"
