#!/usr/bin/env python3
"""Verify timeout exit status and process-group cleanup."""

import os
from pathlib import Path
import signal
import subprocess
import sys
import tempfile
import time


helper = Path(__file__).with_name("run-with-timeout")
subprocess.run([str(helper), "5", sys.executable, "-c", "pass"], check=True)

child_code = (
    "import os,signal,sys,time; "
    "signal.signal(signal.SIGTERM, signal.SIG_IGN); "
    "open(sys.argv[1],'w').write(str(os.getpid())); time.sleep(30)"
)
parent_code = (
    "import signal,subprocess,sys,time; "
    "subprocess.Popen([sys.executable,'-c',sys.argv[1],sys.argv[2]]); "
    "signal.signal(signal.SIGTERM,lambda *_: sys.exit(0)); time.sleep(30)"
)

with tempfile.TemporaryDirectory(prefix="yaagl-timeout-test-") as directory:
    pid_path = Path(directory) / "child.pid"
    try:
        result = subprocess.run(
            [str(helper), "0.5", sys.executable, "-c", parent_code, child_code, str(pid_path)],
            capture_output=True,
            text=True,
            timeout=12,
        )
        if result.returncode != 124:
            raise SystemExit(f"expected timeout exit 124, got {result.returncode}: {result.stderr}")
        if not pid_path.exists():
            raise SystemExit("the child process did not start")

        child_pid = int(pid_path.read_text())
        for _ in range(40):
            state = subprocess.run(
                ["ps", "-p", str(child_pid), "-o", "stat="], capture_output=True, text=True
            ).stdout.strip()
            if not state or state.startswith("Z"):
                print("run-with-timeout test: passed (exit code and child process cleanup)")
                break
            time.sleep(0.05)
        else:
            raise SystemExit(f"child process survived timeout cleanup: pid={child_pid}, state={state}")
    finally:
        if pid_path.exists():
            try:
                os.kill(int(pid_path.read_text()), signal.SIGKILL)
            except ProcessLookupError:
                pass
