#!/bin/sh
# Asserts what a built Yaagl.app must contain: x86_64 helpers in Contents/Helpers/ and the
# protonextras Windows files in Contents/Resources/protonextras/, DXMT in Contents/Resources/dxmt/ (if built), plus the required Info.plist keys. Usage: check-bundle [Yaagl.app]
set -eu
cd "$(dirname "$0")/../.."
app="${1:-build/DerivedData/Build/Products/Debug/Yaagl.app}"
fail=0
for helper in yaagl-wine-shim yaagl-gamehost.dylib; do
  path="$app/Contents/Helpers/$helper"
  if [ ! -f "$path" ]; then echo "missing: $path"; fail=1; continue; fi
  if [ "$(lipo -archs "$path")" != "x86_64" ]; then echo "not x86_64-only: $path"; fail=1; fi
  codesign --verify --strict "$path" || { echo "bad signature: $path"; fail=1; }
done
for extra in steam32.exe steam64.exe lsteamclient32.dll lsteamclient64.dll; do
  [ -f "$app/Contents/Resources/protonextras/$extra" ] || { echo "missing: protonextras/$extra"; fail=1; }
done
# DXMT (scripts/build-dxmt) is checked when it was built into the bundle or REQUIRE_DXMT=1 (the release build).
dxmt="$app/Contents/Resources/dxmt"
if [ -d "$dxmt" ] || [ "${REQUIRE_DXMT:-0}" = 1 ]; then
  for f in x86_64-windows/d3d10core.dll x86_64-windows/d3d11.dll x86_64-windows/dxgi.dll x86_64-windows/winemetal.dll \
           x86_64-unix/winemetal.so VERSION COPYING.LIB LICENSE.LLVM; do
    [ -s "$dxmt/$f" ] || { echo "missing: dxmt/$f"; fail=1; }
  done
fi
# Sparkle reaches the app through the Updates package product (#87); Xcode must still embed the framework.
sparkle="$app/Contents/Frameworks/Sparkle.framework"
codesign --verify --deep --strict "$sparkle" || { echo "missing or badly signed: $sparkle"; fail=1; }
# Sparkle defaults: check on its own without the first-launch permission prompt, once a day.
plist="$app/Contents/Info.plist"
want() { [ "$(/usr/libexec/PlistBuddy -c "Print :$1" "$plist" 2>/dev/null)" = "$2" ] || { echo "Info.plist: $1 must be $2"; fail=1; }; }
want SUEnableAutomaticChecks true
want SUScheduledCheckInterval 86400
# Finder shows the localized display name only with this key.
want LSHasLocalizedDisplayName true
exit $fail
