#!/bin/sh
# Checks shared by lefthook pre-push and CI: parity coverage (report mode unless
# PARITY_STRICT=1), swift test, then generate the
# Xcode project and build the app from the command line.
set -eu
cd "$(dirname "$0")/../.."
scripts/dev/parity-coverage
SWIFT_BACKTRACE=enable=yes,color=no,output-to=stderr,symbolicate=full swift test
xcodegen generate
xcodebuild -project Yaagl.xcodeproj -scheme Yaagl -configuration Debug \
  -destination 'platform=macOS,arch=arm64' -derivedDataPath build/DerivedData build

scripts/dev/check-bundle
