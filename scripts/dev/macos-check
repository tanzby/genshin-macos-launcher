#!/bin/sh
# Checks shared by lefthook pre-push and CI: parity coverage (strict: every rule has a test or diag check),
# swift test, then generate the Xcode project and build the app from the command line.
set -eu
cd "$(dirname "$0")/../.."
# SwiftPM and Xcode must agree on Package.resolved (#87): neither swift test nor the app build may rewrite it.
resolved=$(git hash-object Package.resolved)
scripts/dev/parity-coverage --strict
scripts/dev/check-async-closure-default
swift test
xcodegen generate
xcodebuild -project GenshinLauncher.xcodeproj -scheme GenshinLauncher -configuration Debug \
  -destination 'platform=macOS,arch=arm64' -derivedDataPath build/DerivedData build
[ "$(git hash-object Package.resolved)" = "$resolved" ] || { git diff Package.resolved; echo "Package.resolved was rewritten (#87)"; exit 1; }

scripts/dev/check-bundle
