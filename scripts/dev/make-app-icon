#!/usr/bin/env swift
// Builds App/Assets.xcassets/AppIcon.appiconset from one square image (best 1024×1024):
// masks it to the macOS icon grid (824/1024 rounded rectangle, radius 185) and writes every slot.
// Usage: scripts/dev/make-app-icon <source image>
import AppKit

let args = CommandLine.arguments
guard args.count == 2, let source = NSImage(contentsOfFile: args[1]) else {
  FileHandle.standardError.write("usage: make-app-icon <source image>\n".data(using: .utf8)!)
  exit(1)
}
let output = URL(fileURLWithPath: #filePath).deletingLastPathComponent()
  .appending(path: "../../App/Assets.xcassets/AppIcon.appiconset").standardized

for pixels in [16, 32, 64, 128, 256, 512, 1024] {
  let rep = NSBitmapImageRep(
    bitmapDataPlanes: nil, pixelsWide: pixels, pixelsHigh: pixels, bitsPerSample: 8, samplesPerPixel: 4,
    hasAlpha: true, isPlanar: false, colorSpaceName: .deviceRGB, bytesPerRow: 0, bitsPerPixel: 0)!
  NSGraphicsContext.saveGraphicsState()
  NSGraphicsContext.current = NSGraphicsContext(bitmapImageRep: rep)
  let size = CGFloat(pixels)
  let margin = size * 100 / 1024
  let rect = NSRect(x: margin, y: margin, width: size - 2 * margin, height: size - 2 * margin)
  NSBezierPath(roundedRect: rect, xRadius: size * 185 / 1024, yRadius: size * 185 / 1024).addClip()
  source.draw(in: rect)
  NSGraphicsContext.restoreGraphicsState()
  try rep.representation(using: .png, properties: [:])!.write(to: output.appending(path: "icon_\(pixels).png"))
}
