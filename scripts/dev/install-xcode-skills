#!/bin/sh
# Installs the SwiftUI guidance that ships inside Xcode as a local agent skill, by default
# ~/.claude/skills/swiftui-specialist. Apple's text is copied from your own Xcode and never committed.
# usage: install-xcode-skills [destination-dir]
set -eu
resources="$(xcode-select -p)/../PlugIns/IDEIntelligenceChat.framework/Versions/A/Resources"
template="$resources/swiftui-specialist.idechatprompttemplate"
[ -f "$template" ] || { echo "this Xcode does not ship swiftui-specialist ($resources)"; exit 1; }
dest=${1:-$HOME/.claude/skills/swiftui-specialist}
mkdir -p "$dest/references"
cp "$template" "$dest/SKILL.md"
for ref in "$resources"/swiftui-specialist-ref-*.md.packaged; do
  name=$(basename "$ref" .md.packaged)
  cp "$ref" "$dest/references/${name#swiftui-specialist-ref-}.md"
done
echo "installed $dest"
