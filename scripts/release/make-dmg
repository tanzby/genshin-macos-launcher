#!/bin/bash
# Builds the release DMG: the app, a link to /Applications and 安装说明.txt. People install from it, and Sparkle
# installs updates from the same file: its disk image unarchiver copies only bundles, folders and .pkg files, so it
# skips the link and the text file.
#
#   scripts/release/make-dmg <app> <out.dmg>
set -euo pipefail
[ $# -eq 2 ] || { echo "usage: $0 <app> <out.dmg>" >&2; exit 2; }
app=$1
out=$2

root=$(mktemp -d)
trap 'rm -rf "$root"' EXIT
# ditto keeps symlinks, so the framework signatures stay valid.
ditto "$app" "$root/$(basename "$app")"
ln -s /Applications "$root/Applications"
cp "$(dirname "$0")/dmg-install.txt" "$root/安装说明.txt"
hdiutil create -quiet -ov -volname "Genshin Launcher" -srcfolder "$root" -fs APFS -format ULFO "$out"
