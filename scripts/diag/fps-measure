#!/bin/zsh
# Usage: fps-measure <gptk4|dxmt>... Bounded present-time measurement on the REAL data directory and logged-in
# prefix, one run per argument (e.g. `fps-measure gptk4 dxmt gptk4 dxmt`). Each run starts a copy of the installed
# app with the dev companion in measure mode (Helpers/gamehost-dev.m), which enters the world; then W and S are held
# 15 s each so the character walks out and back, and the companion logs `present:` lines from the drawables'
# presentedTime; `gpu:` lines give the GPU utilization over the same 15 s. The game is closed with wineserver -k
# after every run; the graphics backend preference is set back to its previous value at the end. FPS_MEASURE_APP=<path>
# measures another build than the installed app.
# Every hitch (present interval > 50 ms) is attributed: `hitch:` lines carry the wall-clock time of the late frame; a
# 0.25 s poller records the size of the backend's shader cache (`$DARWIN_USER_CACHE_DIR/{d3dm,dxmt}/YuanShen.exe`) and
# the GPU utilization keeps its timestamps. A hitch whose window (from `dur` + 200 ms before the late frame to 200 ms
# after it) saw the cache grow is `cause=shader-cache`; one with GPU utilization >= 90% is `cause=gpu`; the rest are
# `cause=unknown`. The summary line is `HITCH backend=… cache=cold|warm cause=… count=…`. FPS_MEASURE_COLD=1 moves the
# backend cache aside for the run and puts it back afterwards (a cold-cache run).
# Not done: xctrace "Metal System Trace" on the Wine process (see docs/gptk4-beta3-integration.md) and hitch-triggered
# `sample`: hitch lines only exist after the phase ends, too late to sample the stall.
# Apple's GPTK payload in the copy is not re-signed (only the outer bundle).
set -eu
zmodload zsh/datetime
repo=${0:A:h:h:h}
app=${FPS_MEASURE_APP:-"/Applications/Genshin Launcher.app"}
data="$HOME/Library/Application Support/Genshin Launcher"
log="$data/logs/gamehost.log"
work=$(mktemp -d -t fps-measure)
domain=io.github.tanzby.genshin-launcher
previous=$(defaults read $domain graphicsBackend 2>/dev/null || echo gptk4)
# Closes the game in the shared prefix (whichever runtime runs it) and the launcher copy.
close_game() {
  "$repo/scripts/diag/genshin-launcher-diag" kill --data-dir "$data" >/dev/null
  sleep 3
  pkill -f "$work/Genshin Launcher.app/Contents/MacOS" 2>/dev/null || true
}
cleanup() {
  close_game
  restore_cache
  defaults write $domain graphicsBackend -string "$previous"
  rm -rf "$work"
}
trap cleanup EXIT
cachedir=$(getconf DARWIN_USER_CACHE_DIR)
aside=""
restore_cache() {
  [ -n "$aside" ] || return 0
  rm -rf "${aside%.fps-measure-aside}"
  mv "$aside" "${aside%.fps-measure-aside}"
  aside=""
}
pgrep -f 'YuanShen.exe|wineserver|Contents/MacOS/Genshin Launcher' >/dev/null && { echo "quit the launcher and the game first"; exit 1; }

ditto "$app" "$work/Genshin Launcher.app"
sh "$repo/Helpers/build.sh" "$work/Genshin Launcher.app/Contents/Helpers" >/dev/null
# The copy runs this checkout's game host too (Debug mode lines), not the installed app's.
clang -arch x86_64 -O2 -Wall -dynamiclib -undefined dynamic_lookup -install_name /usr/local/lib/genshin-launcher-gamehost.dylib \
  -o "$work/Genshin Launcher.app/Contents/Helpers/genshin-launcher-gamehost.dylib" "$repo/Helpers/gamehost.c" "$repo/Helpers/fps-unlock.c"
codesign -f -s - "$work/Genshin Launcher.app/Contents/Helpers/genshin-launcher-gamehost.dylib" 2>/dev/null
codesign -f -s - "$work/Genshin Launcher.app" 2>/dev/null
"$repo/scripts/dev/check-gptk4" "$work/Genshin Launcher.app/Contents/Resources/gptk4" >/dev/null
swiftc -O -o "$work/holdkey" "$repo/scripts/diag/holdkey.swift"
game_dir=$(defaults read $domain gameDirectory)

for backend in "$@"; do
  defaults write $domain graphicsBackend -string "$backend"
  cache="$cachedir/$([ $backend = dxmt ] && echo dxmt || echo d3dm)/YuanShen.exe"
  cache_state=warm
  if [ -n "${FPS_MEASURE_COLD:-}" ]; then
    cache_state=cold
    [ -e "$cache" ] && { mv "$cache" "$cache.fps-measure-aside"; aside="$cache.fps-measure-aside"; }
  fi
  start=$(wc -l < "$log" 2>/dev/null || echo 0)
  # A clean environment: the game inherits the launcher's.
  env -i HOME=$HOME USER=$USER LOGNAME=$USER TMPDIR=$TMPDIR PATH=/usr/bin:/bin:/usr/sbin:/sbin \
    open -n --env GENSHIN_LAUNCHER_DEBUG=1 --env GENSHIN_LAUNCHER_GAMEHOST_STALLS="$work/stalls.$backend" --env GENSHIN_LAUNCHER_GAMEHOST_DEV=measure --env GENSHIN_LAUNCHER_AUTOLAUNCH=1 \
    --env GENSHIN_LAUNCHER_GAME_DIR="$game_dir" "$work/Genshin Launcher.app" --args --autolaunch
  newlog() { tail -n +$((start + 1)) "$log" 2>/dev/null; }
  deadline=$((SECONDS + 300))
  until newlog | grep -q 'measure: ready' || (( SECONDS > deadline )); do sleep 2; done
  pid=$(pgrep -f '^Z:.*YuanShen.exe' | tail -1 || true)
  if newlog | grep -q 'measure: ready' && [ -n "$pid" ]; then
    sleep 10
    # FPS_MEASURE_XCTRACE=<template> records the game process with xctrace for the two key phases (limit 40 s).
    xctrace_pid=""
    if [ -n "${FPS_MEASURE_XCTRACE:-}" ]; then
      mkdir -p "${FPS_MEASURE_OUT:-${TMPDIR:-/tmp}/fps-measure-out}"
      rm -rf "${FPS_MEASURE_OUT:-${TMPDIR:-/tmp}/fps-measure-out}/xctrace.$backend.trace"
      xcrun xctrace record --template "$FPS_MEASURE_XCTRACE" --attach $pid --time-limit 40s --no-prompt \
        --output "${FPS_MEASURE_OUT:-${TMPDIR:-/tmp}/fps-measure-out}/xctrace.$backend.trace" > "$work/xctrace.log" 2>&1 &
      xctrace_pid=$!
      sleep 5
      cat "$work/xctrace.log"
    fi
    # Cache size in KiB every 0.25 s: "epoch kib".
    ( while :; do print -r -- "$EPOCHREALTIME $(du -sk "$cache" 2>/dev/null | cut -f1)"; sleep 0.25; done ) \
      > "$work/cache" &
    cache_sampler=$!
    : > "$work/gpu"
    for key in W S; do
      "$repo/scripts/diag/genshin-launcher-diag" activate "$pid" --timeout 10 >/dev/null || echo "activate failed"
      # GPU utilization while walking (IOAccelerator "Device Utilization %", sampled every 0.5 s): headroom under
      # the frame cap. It reflects the GPU's current clock, so it is a comparison, not an absolute capacity.
      ( while :; do u=$(ioreg -r -d 1 -c IOAccelerator -w0 | grep -oE '"Device Utilization %"=[0-9]+' | cut -d= -f2)
          print -r -- "$EPOCHREALTIME $u"; sleep 0.5; done ) > "$work/gpu.$key" &
      sampler=$!
      "$work/holdkey" $([ $key = W ] && echo 13 || echo 1) 15
      kill $sampler
      cat "$work/gpu.$key" >> "$work/gpu"
      awk -v k=$key '{s+=$2; if ($2>m) m=$2; n++} END {printf "gpu: phase=%s samples=%d mean=%.0f%% max=%d%%\n", k, n, s/n, m}' "$work/gpu"
      sleep 3
    done
    kill $cache_sampler
    [ -z "$xctrace_pid" ] || { wait $xctrace_pid || true; tail -5 "$work/xctrace.log"; }
  else
    echo "timed out before the world"
  fi
  close_game
  echo "== $backend $(date +%H:%M:%S)"
  newlog | grep -E 'present:|dev companion unavailable' || echo "no present lines"
  newlog | grep 'hitch:' | sed 's/^.*hitch:/hitch:/' > "$work/hitches"
  cat "$work/hitches"
  # Stall sampler output (stall:/stack:/nd: lines, Helpers/gamehost-dev.m), kept for analysis.
  out=${FPS_MEASURE_OUT:-${TMPDIR:-/tmp}/fps-measure-out}
  mkdir -p "$out"
  if [ -s "$work/stalls.$backend" ]; then
    cp "$work/stalls.$backend" "$out/stalls.$backend.$cache_state.$(date +%H%M%S).log"
    echo "stalls: $(grep -c '^stall:' "$work/stalls.$backend") captured, nextDrawable>10ms: $(grep -c '^nd:' "$work/stalls.$backend"), saved in $out"
    "$repo/scripts/diag/stall-report" --hitches "$work/hitches" "$work/stalls.$backend" | grep -E '^(hitch|HITCH-STALL|STALLS)'
  fi
  touch "$work/cache" "$work/gpu"
  # Attribute each hitch. Hitch wall time w = late frame; the stall began dur ms earlier.
  awk -v backend=$backend -v state=$cache_state '
    FILENAME ~ /cache$/ { if (NF == 2) { ct[nc] = $1; ck[nc++] = $2 }; next }
    FILENAME ~ /gpu$/   { if (NF == 2 && $2 != "") { gt[ng] = $1; gu[ng++] = $2 }; next }
    { for (i = 1; i <= NF; i++) { if ($i ~ /^wall=/) w = substr($i, 6) + 0; if ($i ~ /^dur=/) d = substr($i, 5) + 0 }
      lo = w - d / 1000 - 0.2; hi = w + 0.2; cause = "unknown"
      for (i = 1; i < nc; i++) if (ct[i] >= lo && ct[i - 1] <= hi && ck[i] > ck[i - 1]) cause = "shader-cache"
      if (cause == "unknown") for (i = 0; i < ng; i++) if (gt[i] >= lo && gt[i] <= hi && gu[i] >= 90) cause = "gpu"
      n[cause]++; total++
      printf "hitch-cause: wall=%.3f dur=%.1fms cause=%s\n", w, d, cause }
    END { for (c in n) printf "HITCH backend=%s cache=%s cause=%s count=%d\n", backend, state, c, n[c]
          if (!total) printf "HITCH backend=%s cache=%s cause=none count=0\n", backend, state }
  ' "$work/cache" "$work/gpu" "$work/hitches"
  restore_cache
  sleep 5
done
